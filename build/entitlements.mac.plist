<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      The hardened runtime is required for notarisation, and it switches OFF a
      handful of things Electron needs. Only those are asked for here.

      JIT and unsigned executable memory: V8 compiles JavaScript at runtime.
      Without these the renderer cannot start at all.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!--
      Chromium loads its own frameworks, which are signed with this app's identity
      rather than Apple's team-scoped library validation expects.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!--
      Reading the PDFs the user opens, and writing the ones they export. Nothing
      else: no network entitlement is requested, because the app makes no
      outbound connection of its own — an AI endpoint is one the user types in,
      and it is normally localhost.
    -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
